# Copy to .env and adjust. Used by `npm run dev` and by docker compose.

# --- Frontend ---------------------------------------------------------------
# Public URL of PocketBase as seen from the guest's BROWSER.
VITE_POCKETBASE_URL=http://localhost:8090

# --- PocketBase (docker compose) --------------------------------------------
# Superuser for the admin dashboard (http://localhost:8090/_/). CHANGE IT.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please-123
# Public URL of the frontend: used in the confirmation / reset e-mail links.
FRONTEND_URL=http://localhost:8080
PB_APP_NAME=Giulia & Marco
PB_SENDER_NAME=Giulia & Marco
PB_SENDER_ADDRESS=noreply@example.com
# Allowed CORS origins for the API (comma separated, * = any).
PB_ORIGINS=http://localhost:8080,http://localhost:5173

# SMTP: defaults to the local Mailpit container (inbox at http://localhost:8025).
# For production use your provider (e.g. smtp.sendgrid.net, port 587).
PB_SMTP_HOST=mailpit
PB_SMTP_PORT=1025
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=false

# --- Sign-up secret codes ------------------------------------------------------
# Starting values only, read when the database is created (and the super-admin
# one at the first start of this version): change them afterwards from the site,
# Site settings → Sign-up code. Quote them: an unquoted # can start a comment.
# The guests' code (it can be printed on the invitations). Not set: a random
# one, written to the PocketBase log.
PB_SIGNUP_CODE="#wedding"
# Signing up with this one makes the account a SUPER ADMIN (everything, like
# the couple): at least 10 characters, different from the guests' code. Never
# print it. Not set: nobody can sign up as a super admin.
PB_SUPERADMIN_SIGNUP_CODE=
