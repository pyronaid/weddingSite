# Normalize line endings in the repository.
* text=auto

# Files executed or parsed inside Linux containers must keep LF endings,
# even on Windows checkouts with core.autocrlf=true. A CRLF shebang
# ("#!/bin/sh\r") makes the kernel look for "/bin/sh\r" and the container
# fails with "exec ...: no such file or directory".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
# Copied as is to the Linux server: a CRLF in .env ends up inside values
# (e.g. the image owner) for the scripts that read it.
deploy/**   text eol=lf
# Generated by `npm run brand` and compared byte for byte by a test.
public/brand/*.svg text eol=lf
# The logo borders: the ready-made logos are made from them.
src/brand/borders/*.svg text eol=lf
# The invitations' decorations and patterns (same files on every checkout).
src/prints/decorations/*.svg text eol=lf
src/prints/patterns/*.svg text eol=lf
# Pictures (decorations, photos): never touched as text.
*.webp binary
*.png  binary
