# Production settings, kept ONLY on the server as /opt/wedding/.env
# (chmod 600: it holds passwords). Never commit the real file.

# --- Images (pushed by the GitHub Actions pipeline) -------------------------
# GitHub user or organisation that owns the repository, lowercase.
GHCR_OWNER=pyronaid
# Version deployed: deploy.sh sets it to the commit being deployed.
IMAGE_TAG=latest

# --- Domains -----------------------------------------------------------------
# The site, e.g. giuliaemarco.it (www.giuliaemarco.it redirects to it).
SITE_DOMAIN=example.com
# PocketBase (API, photos, admin UI at https://api.example.com/_/).
API_DOMAIN=api.example.com
# Let's Encrypt writes here about certificate problems.
ACME_EMAIL=you@example.com

# --- PocketBase superuser (admin UI) ------------------------------------------
# Created/updated at every start. Use a long, unique password.
PB_ADMIN_EMAIL=you@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- E-mails (confirmation and password reset) -------------------------------
PB_APP_NAME=Giulia & Marco
PB_SENDER_NAME=Giulia & Marco
# An address of YOUR domain, verified at the mail provider.
PB_SENDER_ADDRESS=noreply@example.com
# Brevo example; see bring_to_prod_instructions.md for other providers.
PB_SMTP_HOST=smtp-relay.brevo.com
# 587 + STARTTLS: PB_SMTP_TLS=false (true only for port 465, often blocked by hosts).
PB_SMTP_PORT=587
PB_SMTP_USERNAME=
PB_SMTP_PASSWORD=
PB_SMTP_TLS=false

# --- Wedding day ---------------------------------------------------------------
# Public IP of the venue's Wi-Fi (guests on it share it): the rate limits do not
# apply to it. Comma separated; "-" clears the list; empty leaves it as it is.
PB_RATE_LIMIT_EXCLUDED_IPS=
